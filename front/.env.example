# URL de base de l'API back
# Exemple en local avec Spring Boot par défaut
VITE_API_BASE_URL=http://localhost:8080

# Pagination par défaut pour les listes (si supporté par l'API)
VITE_PAGE_SIZE=20

# Timeout (ms) pour l'export PDF des bulletins
VITE_EXPORT_TIMEOUT_MS=30000

# Chemin d'export des bulletins (GET blob)
# Exemple(s) possibles selon votre backend :
#   /api/bulletin/export?eleveId=...&trimestre=T1&annee=2024
#   /api/bulletin/{eleveId}/export?trimestre=T1&annee=2024
VITE_BULLETIN_EXPORT_PATH=/api/bulletin/export
